{
  "manifest_version": 3,
  "name": "hyoumoji - YouTube Emojis, GIFs & Animated Stickers",
  "version": "1.0.1",
  "description": "Add rich emojis, trending GIFs, and animated stickers directly to YouTube comments for PC users.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "hyoumoji"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://api.giphy.com/*",
    "https://*.giphy.com/*",
    "https://*.tenor.com/*",
    "https://tenor.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}

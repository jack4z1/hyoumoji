{
  "manifest_version": 3,
  "name": "hyoumoji - Emojis & ASCII",
  "version": "2.1.0",
  "description": "WhatsApp-style Emojis and 41,000+ ASCII Faces, Art & Braille tailored to YouTube Comments, Shorts, Live Chat, Twitch, Kick, and more.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "hyoumoji"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://*.kick.com/*",
        "*://*.rumble.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "data/*.json"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://*.kick.com/*",
        "*://*.rumble.com/*",
        "*://*.tiktok.com/*"
      ]
    }
  ]
}
